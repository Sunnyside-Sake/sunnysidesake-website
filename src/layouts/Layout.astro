---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logoMarkFlare from '../assets/logo-mark-flare.svg';
import logoMarkFlareWide from '../assets/logo-mark-flare-wide.svg';
import { t } from '../i18n/en';
import { defaultTheme, themeBg } from '../config/themes';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = t.meta.defaultDescription } = Astro.props;
const pageTitle = title ? `${title} — ${t.brand.name}` : `${t.brand.name}`;

/**
 * Makgeolli is deliberately NOT here. It is a one-off experiment, not a
 * product line, and equal nav billing would claim otherwise. It stays fully
 * published and reachable — linked from the foot of the sake index and from
 * the footer — just not presented as a second line.
 *
 * The gallery uses the short label "Wild" rather than "In the wild" or
 * "Gallery": five items is the most this row fits on a 375px phone, and only
 * with the shortest label that still reads.
 */
const navItems = [
  { href: '/batches', label: t.nav.batches },
  { href: '/gallery', label: t.gallery.navLabel },
  { href: '/artists', label: t.nav.artists },
  { href: '/journal', label: t.nav.journal },
  { href: '/about', label: t.nav.about },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<!doctype html>
<html lang={t.locale} data-theme={defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    {/* SVG first: the browser rasterises it at whatever size the context
        needs (16/32/48/64) instead of downscaling one fixed bitmap. The PNG
        is the fallback for browsers without SVG icon support; apple-touch-icon
        must stay PNG and needs an opaque ground, since iOS composites it onto
        the home screen with no transparency handling. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <meta name="theme-color" content={themeBg[defaultTheme]} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/favicon-512.png" />
    <meta name="twitter:card" content="summary" />

    {/* Preload the two faces used above the fold — avoids a flash of fallback
        on the hero, which is the first thing anyone sees. */}
    <link rel="preload" href="/fonts/plex-mono-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plex-sans-400.woff2" as="font" type="font/woff2" crossorigin />

    <meta name="generator" content={Astro.generator} />
  </head>

  <body class="min-h-screen flex flex-col bg-ink-950">
    <header class="sticky top-0 z-50 bg-ink-950/85 backdrop-blur-md border-b border-ink-800">
      {/* One row, five items, 64px tall on every width.
          Five wide-tracked uppercase labels do not fit a phone at desktop
          spacing — measured at 375px, they need 372px inside a 327px content
          box. The gaps tighten on mobile instead of the type: the 0.18em
          tracking on .label is the brand's, not this row's, to trade away.
          Tightened it needs 304px, so it fits with 23px to spare.
          Below ~360px it stops fitting no matter what, so the list is its own
          scroll container — the nav scrolls internally rather than widening
          the document. That also means a sixth item degrades instead of
          breaking the page, but check this measurement before adding one. */}
      <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between gap-3 sm:gap-8">
        <a href="/" class="flex items-center gap-3 group shrink-0">
          {/* Vector, not raster: a PNG downsampled to 28px averaged the
              outline into ~1.4px of grey and looked fuzzy. The browser
              rasterises SVG against the device pixel grid, so this is sharp at
              any size and density.

              Both gradient variants ship and CSS shows one, so the dev
              switcher can compare them without a rebuild. */}
          <img
            src={logoMarkFlare.src}
            alt=""
            width="28"
            height="32"
            class="mark-flare w-7 h-auto transition-transform duration-300 group-hover:-translate-y-0.5"
          />
          <img
            src={logoMarkFlareWide.src}
            alt=""
            width="28"
            height="32"
            class="mark-flare-wide w-7 h-auto transition-transform duration-300 group-hover:-translate-y-0.5"
          />
          {/* Wordmark as live text, not baked into the logo raster:
              stays crisp at any size and can be swapped for Japanese later. */}
          <span class="display text-[0.9375rem] tracking-tight hidden sm:block">
            {t.brand.name}
          </span>
        </a>

        <ul
          class="flex items-center gap-2 sm:gap-6 min-w-0 overflow-x-auto
                 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
          {
            navItems.map((item) => (
              <li class="shrink-0">
                <a
                  href={item.href}
                  class:list={[
                    'label whitespace-nowrap transition-colors hover:text-ink-100',
                    isActive(item.href) && 'text-flare',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main class="flex-1 w-full">
      <slot />
    </main>

    <footer class="border-t border-ink-800 mt-16">
      <div class="max-w-6xl mx-auto px-6 py-8">
        <div class="flex flex-wrap gap-8 justify-between items-start">
          <div>
            <p class="display text-lg">{t.brand.name}</p>
            <p class="label mt-2">{t.brand.nameJa}</p>
          </div>
          <div class="text-right">
            <a href="/gallery" class="label hover:text-flare transition-colors block">
              {t.footer.gallery} →
            </a>
            <a href="/makgeolli" class="label hover:text-flare transition-colors block mt-1">
              {t.footer.alsoMakgeolli} →
            </a>
            <p class="label mt-3">{t.footer.responsibly}</p>
            <p class="label mt-2 text-ink-500">
              © {new Date().getFullYear()} · {t.footer.rights}
            </p>
          </div>
        </div>
      </div>
    </footer>

    {/* Dev only — never reaches a build. */}
    {import.meta.env.DEV && <ThemeSwitcher />}
  </body>
</html>
