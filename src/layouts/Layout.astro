---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logoMark from '../assets/logo-mark.png';
import logoMarkLight from '../assets/logo-mark-light.png';
import logoMarkSvg from '../assets/logo-mark.svg';
import { t } from '../i18n/en';
import { defaultTheme, themeBg } from '../config/themes';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = t.meta.defaultDescription } = Astro.props;
const pageTitle = title ? `${title} — ${t.brand.name}` : `${t.brand.name}`;

/**
 * Makgeolli is deliberately NOT here. It is a one-off experiment, not a
 * product line, and equal nav billing would claim otherwise. It stays fully
 * published and reachable — linked from the foot of the sake index and from
 * the footer — just not presented as a second line.
 */
const navItems = [
  { href: '/batches', label: t.nav.batches },
  { href: '/artists', label: t.nav.artists },
  { href: '/journal', label: t.nav.journal },
  { href: '/about', label: t.nav.about },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<!doctype html>
<html lang={t.locale} data-theme={defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <meta name="theme-color" content={themeBg[defaultTheme]} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/favicon-512.png" />
    <meta name="twitter:card" content="summary" />

    {/* Preload the two faces used above the fold — avoids a flash of fallback
        on the hero, which is the first thing anyone sees. */}
    <link rel="preload" href="/fonts/plex-mono-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plex-sans-400.woff2" as="font" type="font/woff2" crossorigin />

    <meta name="generator" content={Astro.generator} />
  </head>

  <body class="min-h-screen flex flex-col bg-ink-950">
    <header class="sticky top-0 z-50 bg-ink-950/85 backdrop-blur-md border-b border-ink-800">
      {/* Back to a single row now that nav is four items. Measured at 375px:
          fits with room to spare. Adding a fifth item overflows a phone and
          drags the page sideways — check before you add one. */}
      <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between gap-8">
        <a href="/" class="flex items-center gap-3 group shrink-0">
          {/* Black-outline / white-infill mark, taken from the WRKY label's
              white-ground variant. One asset covers every theme: on light
              grounds the outline carries it, on dark grounds the white infill
              does — so the header needs no light/dark swap. */}
          {/* Vector, not raster. The PNG was downsampled from a 1010px
              extraction to 28px, which averaged a 51px stroke into ~1.4px of
              grey — visibly fuzzy and unfixable at that size. The browser
              rasterises this against the device pixel grid instead, so it is
              sharp at any size and on any display density.

              Sourced from the WRKY label's white-ground SVG with only the two
              oversized page-ground rects removed, so the arch infills survive
              and the geometry is the artwork rather than a reconstruction. */}
          <img
            src={logoMarkSvg.src}
            alt=""
            width="28"
            height="32"
            class="w-7 h-auto transition-transform duration-300 group-hover:-translate-y-0.5"
          />
          {/* Wordmark as live text, not baked into the logo raster:
              stays crisp at any size and can be swapped for Japanese later. */}
          <span class="display text-[0.9375rem] tracking-tight hidden sm:block">
            {t.brand.name}
          </span>
        </a>

        <ul class="flex items-center gap-5 sm:gap-6">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'label transition-colors hover:text-ink-100',
                    isActive(item.href) && 'text-flare',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main class="flex-1 w-full">
      <slot />
    </main>

    <footer class="border-t border-ink-800 mt-16">
      <div class="max-w-6xl mx-auto px-6 py-8">
        <div class="flex flex-wrap gap-8 justify-between items-start">
          <div>
            <p class="display text-lg">{t.brand.name}</p>
            <p class="label mt-2">{t.brand.nameJa}</p>
          </div>
          <div class="text-right">
            <a href="/makgeolli" class="label hover:text-flare transition-colors">
              {t.footer.alsoMakgeolli} →
            </a>
            <p class="label mt-3">{t.footer.responsibly}</p>
            <p class="label mt-2 text-ink-500">
              © {new Date().getFullYear()} · {t.footer.rights}
            </p>
          </div>
        </div>
      </div>
    </footer>

    {/* Dev only — never reaches a build. */}
    {import.meta.env.DEV && <ThemeSwitcher />}
  </body>
</html>
