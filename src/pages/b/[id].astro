---
import Layout from '../../layouts/Layout.astro';
import Placeholder from '../../components/Placeholder.astro';
import { t } from '../../i18n/en';
import { getCollection, render } from 'astro:content';
import { loadReadings } from '../../lib/readings';

/**
 * THE QR TARGET. /b/001
 *
 * This URL is printed on physical labels and is permanent. It must never be
 * renumbered, and it must never language-redirect — printed codes have to resolve
 * deterministically. See PLAN.md §5.
 */
export async function getStaticPaths() {
  const batches = await getCollection('batches', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true
  );
  return batches.map((batch) => ({
    params: { id: batch.data.id },
    props: { batch },
  }));
}

const { batch } = Astro.props;
const { Content } = await render(batch);
const readings = loadReadings(batch.data.id);
const d = batch.data;

const vitals = [
  { label: t.batch.rice, value: d.rice },
  { label: t.batch.polishRatio, value: d.polishRatio ? `${d.polishRatio}%` : undefined },
  { label: t.batch.koji, value: d.koji },
  { label: t.batch.yeast, value: d.yeast },
  { label: t.batch.abv, value: d.abv ? `${d.abv}%` : undefined },
  { label: t.batch.smv, value: d.smv !== undefined ? `${d.smv > 0 ? '+' : ''}${d.smv}` : undefined },
  { label: t.batch.acidity, value: d.acidity },
].filter((v) => v.value !== undefined && v.value !== null);
---

<Layout title={`${t.batches.batchNumber} ${d.id} — ${d.name}`} description={d.thesis}>
  <article>
    <header>
      <p class="tabular text-sm text-rice-400 tracking-[0.2em] uppercase">
        {t.batches.batchNumber} {d.id}
        {d.status === 'active' && <span class="text-accent ml-2">{t.batches.active}</span>}
      </p>
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl tracking-tight mt-3">
        {d.name}
      </h1>
      {d.nameJa && <p class="mt-2 text-rice-600 text-lg">{d.nameJa}</p>}
    </header>

    {/* Thesis leads. A claim, not a vibe — PLAN.md §5. */}
    <section class="mt-10 max-w-2xl">
      <h2 class="tabular text-xs uppercase tracking-[0.2em] text-rice-400">
        {t.batch.thesisLabel}
      </h2>
      <p class="font-[family-name:var(--font-display)] text-2xl mt-3 leading-snug">
        {d.thesis}
      </p>
    </section>

    <div class="mt-12 grid md:grid-cols-[260px_1fr] gap-10 items-start">
      {/* max-w matters: the grid collapses to one column on mobile and an
          unconstrained 3:4 block would eat the whole viewport. */}
      <Placeholder label={`Batch ${d.id}`} class="max-w-[260px]" />

      <div>
        {
          d.tastingNotes.length > 0 && (
            <section>
              <h2 class="tabular text-xs uppercase tracking-[0.2em] text-rice-400">
                {t.batch.sensoryLabel}
              </h2>
              <p class="mt-3">{d.tastingNotes.join(' · ')}</p>
              {d.servingTemp && (
                <p class="mt-2 text-rice-600 text-sm">
                  {t.batch.servingTemp}: {d.servingTemp}
                </p>
              )}
              {d.pairing.length > 0 && (
                <p class="mt-1 text-rice-600 text-sm">
                  {t.batch.pairing}: {d.pairing.join(', ')}
                </p>
              )}
            </section>
          )
        }

        {
          vitals.length > 0 && (
            <section class="mt-8">
              <h2 class="tabular text-xs uppercase tracking-[0.2em] text-rice-400">
                {t.batch.vitalsLabel}
              </h2>
              <dl class="mt-3 grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-3">
                {vitals.map((v) => (
                  <div>
                    <dt class="text-xs text-rice-400">{v.label}</dt>
                    <dd class="tabular">{v.value}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )
        }
      </div>
    </div>

    {/* Fermentation data. Charts land in Phase 4 — this table proves the CSV pipeline. */}
    <section class="mt-14 border-t border-rice-200 pt-8">
      <h2 class="tabular text-xs uppercase tracking-[0.2em] text-rice-400">
        {t.batch.dataLabel}
      </h2>

      {d.status === 'active' && (
        <p class="mt-3 text-sm text-accent">{t.batch.stillFermenting}</p>
      )}

      {
        readings.length === 0 ? (
          <p class="mt-4 text-rice-400">{t.batch.noReadings}</p>
        ) : (
          <div class="mt-4 overflow-x-auto">
            <table class="tabular text-sm min-w-full">
              <thead class="text-rice-400 text-xs uppercase tracking-wider">
                <tr class="border-b border-rice-200">
                  <th class="text-left py-2 pr-6">{t.batch.day}</th>
                  <th class="text-right py-2 pr-6">°C</th>
                  <th class="text-right py-2 pr-6">pH</th>
                  <th class="text-right py-2 pr-6">Baumé</th>
                  <th class="text-right py-2 pr-6">Brix</th>
                  <th class="text-left py-2">Stage</th>
                </tr>
              </thead>
              <tbody>
                {readings.map((r) => (
                  <tr class="border-b border-rice-100">
                    <td class="py-1.5 pr-6">{r.day}</td>
                    <td class="py-1.5 pr-6 text-right">{r.temp ?? '—'}</td>
                    <td class="py-1.5 pr-6 text-right">{r.ph ?? '—'}</td>
                    <td class="py-1.5 pr-6 text-right">{r.baume ?? '—'}</td>
                    <td class="py-1.5 pr-6 text-right">{r.brix ?? '—'}</td>
                    <td class="py-1.5 text-accent text-xs">
                      {r.stage ? t.batch.stages[r.stage] : ''}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>

    {
      d.batchNotes && (
        <section class="mt-12 border-t border-rice-200 pt-8 max-w-2xl">
          <h2 class="tabular text-xs uppercase tracking-[0.2em] text-rice-400">
            {t.batch.notesLabel}
          </h2>
          <p class="mt-3 text-rice-800">{d.batchNotes}</p>
        </section>
      )
    }

    <div class="mt-12 max-w-2xl prose-sm">
      <Content />
    </div>
  </article>
</Layout>
