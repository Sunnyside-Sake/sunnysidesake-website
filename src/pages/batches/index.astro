---
import Layout from '../../layouts/Layout.astro';
import Placeholder from '../../components/Placeholder.astro';
import { Image } from 'astro:assets';
import { t } from '../../i18n/en';
import { getCollection } from 'astro:content';
import { loadReadings } from '../../lib/readings';

const batches = (
  await getCollection('batches', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true
  )
).sort((a, b) => b.data.id.localeCompare(a.data.id));

// Reading count per batch — the catalogue's real currency for this audience.
const counts = new Map(batches.map((b) => [b.data.id, loadReadings(b.data.id).length]));
---

<Layout title={t.batches.title}>
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-12 md:pt-20">
    <h1 class="display text-4xl md:text-5xl">{t.batches.title}</h1>
    <p class="prose-body mt-5 text-lg">{t.batches.intro}</p>
    <div class="arch-rule mt-10" />
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-20">
    {batches.length === 0 && <p class="label">{t.batches.empty}</p>}

    <ul class="grid grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-12">
      {
        batches.map((batch) => (
          <li>
            <a href={`/b/${batch.data.id}`} class="group block">
              <div class="relative">
                {batch.data.bottle ? (
                  <Image src={batch.data.bottle} alt={`${batch.data.name} bottle`}
                    widths={[400, 800]} sizes="(min-width:1024px) 320px, 45vw"
                    class="w-full aspect-[3/4] object-cover border border-ink-800" />
                ) : (
                  <Placeholder label={`Batch ${batch.data.id}`} />
                )}
                {batch.data.status === 'active' && (
                  <span class="label absolute top-3 left-3 flex items-center gap-2 bg-ink-950/80 backdrop-blur px-2 py-1 text-flare">
                    <span class="inline-block h-1.5 w-1.5 rounded-full bg-flare animate-pulse" />
                    {t.batches.active}
                  </span>
                )}
              </div>

              <div class="mt-4 flex items-baseline justify-between gap-3">
                <span class="tabular text-sm text-ink-500">{batch.data.id}</span>
                {counts.get(batch.data.id)! > 0 && (
                  <span class="tabular text-xs text-ink-500">
                    {counts.get(batch.data.id)} readings
                  </span>
                )}
              </div>

              <h2 class="display text-xl mt-1 group-hover:text-flare transition-colors">
                {batch.data.name}
              </h2>

              <p class="mt-2 text-sm text-ink-400">“{batch.data.tagline}”</p>
              {batch.data.grade && (
                <p class="label mt-2 text-ink-500">{batch.data.grade}</p>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    {/* Aside, not a second product line. Deliberately at the foot of the sake
        index rather than in the nav — see the note in Layout.astro. */}
    <aside class="mt-20 pt-10 border-t border-ink-800">
      <a href="/makgeolli" class="group inline-block max-w-xl">
        <p class="label group-hover:text-flare transition-colors">
          {t.makgeolli.asideLabel} →
        </p>
        <p class="prose-body mt-3">{t.makgeolli.asideBody}</p>
      </a>
    </aside>
  </section>
</Layout>
