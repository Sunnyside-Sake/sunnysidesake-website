---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { t } from '../../i18n/en';
import { getCollection } from 'astro:content';

const shots = (
  await getCollection('gallery', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true
  )
).sort((a, b) => {
  // Newest first where dated; undated entries keep their filename order
  // behind them rather than jumping to the front on a 0 timestamp.
  const at = a.data.date?.getTime();
  const bt = b.data.date?.getTime();
  if (at && bt) return bt - at;
  if (at) return -1;
  if (bt) return 1;
  return a.id.localeCompare(b.id);
});

// Batch accents, so a shot tagged with a batch can carry its colour.
const batches = await getCollection('batches');
const accentFor = new Map(
  batches.map((b) => [b.data.name.toLowerCase(), b.data.accent])
);
---

<Layout title={t.gallery.title} description={t.gallery.intro}>
  <section class="max-w-6xl mx-auto px-6 pt-10 pb-8 md:pt-12">
    <div class="flex flex-wrap items-baseline gap-4">
      <h1 class="display text-4xl md:text-5xl">{t.gallery.title}</h1>
      <span class="label text-ink-400">{t.gallery.titleJa}</span>
    </div>
    <p class="prose-body mt-3">{t.gallery.intro}</p>
    <div class="arch-rule mt-6"></div>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-16">
    {shots.length === 0 && <p class="label">{t.gallery.empty}</p>}

    {/* Masonry via CSS columns rather than a grid.
        Every seeded shot happens to be 3:4 portrait — same phone, same
        orientation — so today this looks much like a grid would. Columns are
        still the right choice: the moment a landscape or square shot is added
        it keeps its own shape instead of being cropped to fit a fixed ratio,
        which is the normal case for photos that arrive one at a time from
        wherever a bottle turned up. */}
    <div class="columns-2 lg:columns-3 gap-4 [column-fill:balance]">
      {
        shots.map((shot) => {
          const accent = shot.data.batch
            ? accentFor.get(shot.data.batch.toLowerCase())
            : undefined;
          return (
            <figure class="mb-4 break-inside-avoid group">
              <div class="relative overflow-hidden bg-ink-900">
                <Image
                  src={shot.data.image}
                  alt={shot.data.caption || 'Sunnyside Sake in the wild'}
                  widths={[400, 800]}
                  sizes="(min-width:1024px) 340px, 45vw"
                  class="w-full h-auto transition-transform duration-500 group-hover:scale-[1.03]"
                />
                {accent && (
                  <span
                    class="absolute left-0 bottom-0 h-1 w-full"
                    style={`background: ${accent};`}
                  />
                )}
              </div>
              {(shot.data.caption || shot.data.venue) && (
                <figcaption class="mt-2 flex flex-wrap items-baseline gap-x-3">
                  {shot.data.caption && (
                    <span class="text-sm text-ink-400">{shot.data.caption}</span>
                  )}
                  {shot.data.venue && (
                    <span class="label text-ink-500">{shot.data.venue}</span>
                  )}
                </figcaption>
              )}
            </figure>
          );
        })
      }
    </div>

    <p class="label mt-10 text-ink-500">{t.gallery.footnote}</p>
  </section>
</Layout>
