---
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import { t } from '../i18n/en';
import { getCollection } from 'astro:content';

// Draft filter: visible in `npm run dev`, excluded from the production build.
// Flipping `draft: false` in frontmatter IS the publish button. See PLAN.md §7.
const batches = await getCollection('batches', ({ data }) =>
  import.meta.env.PROD ? data.draft !== true : true
);

const active = batches.find((b) => b.data.status === 'active');
const released = batches
  .filter((b) => b.data.status === 'released')
  .sort((a, b) => (b.data.released?.getTime() ?? 0) - (a.data.released?.getTime() ?? 0));
const latest = released[0];
---

<Layout>
  <section class="py-8 md:py-16">
    <h1
      class="font-[family-name:var(--font-display)] text-4xl md:text-6xl tracking-tight max-w-3xl"
    >
      {t.brand.tagline}
    </h1>
    <p class="tabular mt-6 text-rice-600 tracking-[0.2em] uppercase text-sm">
      {t.brand.nameJa}
    </p>
  </section>

  {
    active && (
      <section class="py-10 border-t border-rice-200">
        <h2 class="tabular text-sm uppercase tracking-[0.2em] text-accent">
          {t.home.activeBatchLabel}
        </h2>
        <div class="mt-6 grid md:grid-cols-[200px_1fr] gap-8 items-start">
          <Placeholder label={`Batch ${active.data.id}`} />
          <div>
            <h3 class="font-[family-name:var(--font-display)] text-2xl">
              {t.batches.batchNumber} {active.data.id} — {active.data.name}
            </h3>
            <p class="mt-3 text-rice-600 max-w-prose">{active.data.thesis}</p>
            <a
              href={`/b/${active.data.id}`}
              class="tabular inline-block mt-5 text-sm uppercase tracking-[0.15em] text-accent hover:underline"
            >
              {t.home.viewBatch} →
            </a>
          </div>
        </div>
      </section>
    )
  }

  {
    latest && (
      <section class="py-10 border-t border-rice-200">
        <h2 class="tabular text-sm uppercase tracking-[0.2em] text-rice-600">
          {t.home.latestReleaseLabel}
        </h2>
        <div class="mt-6 grid md:grid-cols-[200px_1fr] gap-8 items-start">
          <Placeholder label={`Batch ${latest.data.id}`} />
          <div>
            <h3 class="font-[family-name:var(--font-display)] text-2xl">
              {t.batches.batchNumber} {latest.data.id} — {latest.data.name}
            </h3>
            <p class="mt-3 text-rice-600 max-w-prose">{latest.data.thesis}</p>
            <a
              href={`/b/${latest.data.id}`}
              class="tabular inline-block mt-5 text-sm uppercase tracking-[0.15em] text-accent hover:underline"
            >
              {t.home.viewBatch} →
            </a>
          </div>
        </div>
      </section>
    )
  }
</Layout>
