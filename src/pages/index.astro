---
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import { Image } from 'astro:assets';
import logoMark from '../assets/logo-mark.png';
import logoMarkLight from '../assets/logo-mark-light.png';
import heroImage from '../assets/hero.jpg';
import { t } from '../i18n/en';
import { getCollection } from 'astro:content';
import { loadReadings } from '../lib/readings';

const batches = await getCollection('batches', ({ data }) =>
  import.meta.env.PROD ? data.draft !== true : true
);

const active = batches.find((b) => b.data.status === 'active');
const released = batches
  .filter((b) => b.data.status === 'released')
  .sort((a, b) => {
    // Release dates are not yet recorded for the older batches, and sorting
    // purely on a missing date leaves "latest" arbitrary. Batch ids are
    // sequential, so they are the reliable fallback.
    const byDate = (b.data.released?.getTime() ?? 0) - (a.data.released?.getTime() ?? 0);
    return byDate !== 0 ? byDate : b.data.id.localeCompare(a.data.id);
  });
const latest = released[0];

// Headline stat: total readings published across every batch. This is the
// claim the whole brand rests on, so it should be a number, not an adjective.
const totalReadings = batches.reduce((n, b) => n + loadReadings(b.data.id).length, 0);
---

<Layout>
  {/* ============ HERO ============ */}
  <section class="relative overflow-hidden border-b border-ink-800">
    {/* Sunrise wash behind the mark — the logo gradient as ambient light */}
    <div
      class="absolute inset-0 pointer-events-none opacity-[0.16]"
      style="background: radial-gradient(90% 60% at 50% 108%, var(--color-flare) 0%, var(--color-flare-warm) 25%, transparent 62%);"
    >
    </div>

    <div
      class="relative max-w-6xl mx-auto px-6 pt-12 pb-16 md:pt-16 md:pb-20 grid md:grid-cols-[1fr_auto] gap-10 items-center"
    >
      <div>
      <span class="logo-chip inline-flex">
        <Image src={logoMark} alt="" width={96} height={107} class="logo-dark w-16 md:w-20 h-auto" />
        <Image
          src={logoMarkLight}
          alt=""
          width={96}
          height={107}
          class="logo-light w-16 md:w-20 h-auto"
        />
      </span>

      <h1 class="display text-[1.75rem] leading-[1.1] md:text-4xl lg:text-5xl mt-6 max-w-3xl text-balance">
        {t.brand.tagline}
      </h1>

      <p class="label mt-6">{t.brand.nameJa} · Queens, NY</p>

      {
        totalReadings > 0 && (
          <p class="tabular mt-8 text-sm text-ink-400">
            <span class="text-flare">{totalReadings}</span> readings published across{' '}
            <span class="text-flare">{batches.length}</span>{' '}
            {batches.length === 1 ? 'batch' : 'batches'}
          </p>
        )
      }
      </div>

      {/* Lineup shot: the range in one frame, which the headline claims but
          cannot show. Sits beside the type on desktop, below it on mobile. */}
      <Image
        src={heroImage}
        alt="Sunnyside Sake bottles"
        widths={[380, 760]}
        sizes="(min-width: 768px) 380px, 90vw"
        class="w-full max-w-[380px] h-auto justify-self-end"
        loading="eager"
      />
    </div>
  </section>

  {/* ============ ACTIVE BATCH ============ */}
  {
    active && (
      <section class="max-w-6xl mx-auto px-6 py-12 md:py-14">
        <div class="flex items-center gap-3">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-flare opacity-60" />
            <span class="relative inline-flex rounded-full h-2 w-2 bg-flare" />
          </span>
          <h2 class="label text-flare">{t.home.activeBatchLabel}</h2>
        </div>

        <a href={`/b/${active.data.id}`} class="group block mt-6">
          <div class="grid md:grid-cols-[220px_1fr] gap-8 md:gap-10 items-start">
            {active.data.bottle ? (
              <Image src={active.data.bottle} alt={`${active.data.name} bottle`}
                widths={[220, 440]} sizes="220px"
                class="w-full max-w-[220px] h-auto border border-ink-800" />
            ) : (
              <Placeholder label={`Batch ${active.data.id}`} class="max-w-[220px]" />
            )}
            <div>
              <p class="tabular text-sm text-ink-500">
                {t.batches.batchNumber} {active.data.id}
              </p>
              <h3 class="display text-3xl md:text-4xl mt-2 group-hover:text-flare transition-colors">
                {active.data.name}
              </h3>
              <p class="display text-xl mt-4 text-flare">“{active.data.tagline}”</p>
              <span class="label mt-6 inline-block text-flare">
                {t.home.viewBatch} →
              </span>
            </div>
          </div>
        </a>
      </section>
    )
  }

  {/* ============ LATEST RELEASE ============ */}
  {
    latest && (
      <section class="max-w-6xl mx-auto px-6 pb-12 md:pb-14">
        <div class="arch-rule mb-6" />
        <h2 class="label">{t.home.latestReleaseLabel}</h2>

        <a href={`/b/${latest.data.id}`} class="group block mt-6">
          <div class="grid md:grid-cols-[220px_1fr] gap-8 md:gap-10 items-start">
            {latest.data.bottle ? (
              <Image src={latest.data.bottle} alt={`${latest.data.name} bottle`}
                widths={[220, 440]} sizes="220px"
                class="w-full max-w-[220px] h-auto border border-ink-800" />
            ) : (
              <Placeholder label={`Batch ${latest.data.id}`} class="max-w-[220px]" />
            )}
            <div>
              <p class="tabular text-sm text-ink-500">
                {t.batches.batchNumber} {latest.data.id}
              </p>
              <h3 class="display text-3xl md:text-4xl mt-2 group-hover:text-flare transition-colors">
                {latest.data.name}
              </h3>
              <p class="display text-xl mt-4 text-flare">“{latest.data.tagline}”</p>
              {latest.data.tastingNotes.length > 0 && (
                <p class="label mt-5 text-ink-500">
                  {latest.data.tastingNotes.join(' · ')}
                </p>
              )}
              <span class="label mt-6 inline-block text-flare">
                {t.home.viewBatch} →
              </span>
            </div>
          </div>
        </a>
      </section>
    )
  }

  {/* ============ NEWSLETTER ============ */}
  <section class="border-t border-ink-800">
    <div class="max-w-6xl mx-auto px-6 py-12 md:py-14">
      <h2 class="display text-2xl md:text-3xl max-w-xl">{t.newsletter.heading}</h2>
      {/* TODO Phase 5: wire to Buttondown. Inert until then — deliberately
          not a fake form that silently swallows an address. */}
      <form class="mt-8 flex flex-wrap gap-3 max-w-md" onsubmit="return false;">
        <input
          type="email"
          placeholder={t.newsletter.placeholder}
          disabled
          class="tabular flex-1 min-w-[240px] bg-ink-900 border border-ink-800 px-4 py-3 text-sm placeholder:text-ink-500 focus:outline-none focus:border-flare transition-colors disabled:opacity-60"
        />
        <button
          type="submit"
          disabled
          class="label bg-ink-100 text-ink-950 px-6 py-3 hover:bg-flare transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
        >
          {t.newsletter.submit}
        </button>
      </form>
    </div>
  </section>
</Layout>
